<div class="container-fluid">

  <nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-white">
      <li class="breadcrumb-item">
        <%= link_to "Home", (defined?(main_app) ? main_app.root_path : "/") %>
      </li>
      <li class="breadcrumb-item active">
        <%= I18n.t('coar_notify.title') %>
      </li>
    </ol>
  </nav>

  <div class="row mb-4">
    <div class="col-12">
      <%= link_to I18n.t('coar_notify.manage_connections'), manage_notify_connections_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h4 class="mb-0"><%= I18n.t('coar_notify.messages.title') %></h4>
    </div>

    <div class="card-body p-0">
      <table class="table table-striped table-bordered mb-0">
        <thead>
          <tr>
            <th><%= I18n.t('coar_notify.messages.id') %></th>
            <th><%= I18n.t('coar_notify.messages.type') %></th>
            <th><%= I18n.t('coar_notify.messages.status') %></th>
            <th><%= I18n.t('coar_notify.messages.origin') %></th>
            <th><%= I18n.t('coar_notify.messages.actor') %></th>
            <th><%= I18n.t('coar_notify.messages.work_id') %></th>
          </tr>
        </thead>

        <tbody>
          <% @notifications.each do |notification| %>
            <tr>
              <td><%= notification.id %></td>
              <td><%= notification.request_type %></td>
              <td><%= notification.status %></td>
              <td><%= ENV.fetch("APPLICATION_URL", "") %></td>
              <td><%= notification.user&.respond_to?(:display_name) ? notification.user.display_name : notification.user&.email %></td>
              <td><%= notification.work_id %></td>
            </tr>
          <% end %>

          <% if @notifications.blank? %>
            <tr>
              <td colspan="6" class="text-center">
                <%= I18n.t('coar_notify.messages.no_messages') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="card-footer text-muted">
      <%= I18n.t('coar_notify.messages.messages_found', count: @notifications.count) %>
    </div>
  </div>

</div>
