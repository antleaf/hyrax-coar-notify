<div class="container-fluid"> 
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-white">
      <li class="breadcrumb-item">
        <%= link_to "Home", (defined?(main_app) ? main_app.root_path : "/") %>
      </li>

      <li class="breadcrumb-item">
        <%= link_to I18n.t('coar_notify.title'), (respond_to?(:dashboard_path) ? dashboard_path : root_path) %>
      </li>

      <li class="breadcrumb-item">
        <%= link_to I18n.t('coar_notify.manage_connections'), manage_notify_connections_path %>
      </li>

      <li class="breadcrumb-item active">
        <%= notify_inbox.persisted? ? I18n.t('coar_notify.inbox.edit') : I18n.t('coar_notify.inbox.create') %>
      </li>
    </ol>
  </nav>

  <%= form_with(model: notify_inbox, url: notify_inbox.persisted? ? notify_inbox_path(notify_inbox) : notify_inboxes_path) do |form| %>
    <% if notify_inbox.errors.any? %>
      <div class="alert alert-danger">
        <h5>
          <%= pluralize(notify_inbox.errors.count, "error") %> prohibited this notify inbox from being saved:
        </h5>

        <ul class="mb-0">
          <% notify_inbox.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card">

      <div class="card-header">
        <h4 class="mb-0"><%= notify_inbox.new_record? ? I18n.t('coar_notify.inbox.create') : I18n.t('coar_notify.inbox.edit') %></h4>
      </div>
      <div class="card-body">

        <div class="form-group row">
          <%= form.label :title, class: "col-md-3 col-form-label" %>

          <div class="col-md-9">
            <%= form.text_field :title, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :service_url, "Service URL", class: "col-md-3 col-form-label" %>

          <div class="col-md-9">
            <%= form.text_field :service_url, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :inbox_url, "Inbox URL", class: "col-md-3 col-form-label" %>

          <div class="col-md-9">
            <%= form.text_field :inbox_url, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :api_key, "API Key", class: "col-md-3 col-form-label" %>

          <div class="col-md-9">
            <%= form.text_field :api_key, class: "form-control" %>
          </div>
        </div>

        <div class="form-group row">
          <label class="col-md-3 col-form-label">Target URIs</label>

          <div class="col-md-9">
            <div id="target-uri-container">

              <% (Array(notify_inbox.target_uris).presence || [""]).each_with_index do |url, index| %>
                <div class="input-group mb-2 target-uri-row">
                  <input type="text"
                        name="notify_inbox[target_uris][]"
                        value="<%= url %>"
                        class="form-control">

                  <div class="input-group-append">
                    <% if index.zero? %>
                      <button type="button" class="btn btn-success add-uri">
                        Add
                      </button>
                    <% else %>
                      <button type="button" class="btn btn-danger remove-uri">
                        Remove
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>

            </div>
          </div>
        </div>

        <div class="form-group row">
          <label class="col-md-3 col-form-label"><%= I18n.t('coar_notify.inbox.status') %></label>

          <div class="col-md-9">
            <div class="custom-control custom-radio">
              <%= form.radio_button :status,
                                    true,
                                    class: "custom-control-input",
                                    id: "notify_inbox_status_active" %>

              <label class="custom-control-label" for="notify_inbox_status_active">
                Active
              </label>
            </div>

            <div class="custom-control custom-radio mt-2">
              <%= form.radio_button :status,
                                    false,
                                    checked: !notify_inbox.status,
                                    class: "custom-control-input",
                                    id: "notify_inbox_status_inactive" %>

              <label class="custom-control-label" for="notify_inbox_status_inactive">
                Inactive
              </label>
            </div>
          </div>
        </div>

      </div>

      <div class="card-footer text-right">
        <%= link_to "Cancel", manage_notify_connections_path, class: "btn btn-secondary mr-2" %>
        <%= form.submit "Save", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>

<script>
  $(document).on('click', '.add-uri', function() {
    $('#target-uri-container').append(`
      <div class="input-group mb-2 target-uri-row">
        <input type="text"
               name="notify_inbox[target_uris][]"
               class="form-control">

        <div class="input-group-append">
          <button type="button" class="btn btn-danger remove-uri">
            Remove
          </button>
        </div>
      </div>
    `);
  });

  $(document).on('click', '.remove-uri', function() {
    $(this).closest('.target-uri-row').remove();
  });
</script>
